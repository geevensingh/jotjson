{
  "name": "jotjson",
  "version": "0.14.4",
  "description": "JotJSON - input, store, and display JSON (Angular SPA).",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/geevensingh/jotjson.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/postbuild-seo.mjs",
    "build:prod": "ng build --configuration production",
    "postbuild:prod": "node scripts/postbuild-seo.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "verify:fast": "npm run lint && ng test --watch=false --browsers=ChromeHeadless",
    "lint": "tsc --noEmit -p tsconfig.app.json && node scripts/check-ascii.mjs && node scripts/check-spec-patterns.mjs && node scripts/check-prod-patterns.mjs && node scripts/check-csp-hashes.mjs && node scripts/check-lockfile.mjs && prettier --check .",
    "lint:tsc": "tsc --pretty false --noEmit -p tsconfig.app.json",
    "lint:ascii": "node scripts/check-ascii.mjs",
    "lint:spec-patterns": "node scripts/check-spec-patterns.mjs",
    "lint:prod-patterns": "node scripts/check-prod-patterns.mjs",
    "lint:reduced-motion": "node scripts/check-reduced-motion.mjs",
    "lint:csp-hashes": "node scripts/check-csp-hashes.mjs",
    "lint:lockfile": "node scripts/check-lockfile.mjs",
    "lint:format": "node scripts/check-format.mjs",
    "lint:all": "npm run lint && npm run lint:reduced-motion && npm --prefix api run lint",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check:spec-patterns": "node scripts/check-spec-patterns.mjs",
    "check:prod-patterns": "node scripts/check-prod-patterns.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract-i18n": "ng extract-i18n --output-path=src/locale --out-file=messages.xlf",
    "build:info": "node scripts/write-build-info.mjs",
    "prepare": "husky",
    "prestart": "node scripts/write-build-info.mjs",
    "prebuild": "node scripts/write-build-info.mjs",
    "prebuild:prod": "node scripts/write-build-info.mjs",
    "prewatch": "node scripts/write-build-info.mjs",
    "prelint": "node scripts/write-build-info.mjs",
    "pretest": "node scripts/write-build-info.mjs",
    "pretest:ci": "node scripts/write-build-info.mjs"
  },
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^21.2.10",
    "@angular/compiler": "^21.2.10",
    "@angular/core": "^21.2.10",
    "@angular/forms": "^21.2.10",
    "@angular/material": "^21.2.8",
    "@angular/platform-browser": "^21.2.10",
    "@angular/platform-browser-dynamic": "^21.2.10",
    "@angular/platform-server": "^21.2.10",
    "@angular/router": "^21.2.10",
    "@angular/service-worker": "^21.2.10",
    "@angular/ssr": "21.2.8",
    "@azure/msal-angular": "^5.2.0",
    "@azure/msal-browser": "^5.7.0",
    "@microsoft/applicationinsights-web": "^3.4.1",
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "^0.55.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "web-vitals": "^5.2.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.10",
    "@angular/localize": "^21.2.10",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.0.0",
    "axe-core": "^4.11.4",
    "husky": "^9.1.7",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "karma-junit-reporter": "^2.0.1",
    "karma-spec-reporter": "^0.0.36",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,html,scss,css,json,yml,yaml,bicep,bicepparam,mjs,js}": "prettier --ignore-unknown --write"
  },
  "overrides": {
    "dompurify": "3.4.1",
    "postcss": "^8.5.10",
    "uuid": "^14.0.0"
  }
}
