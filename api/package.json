{
  "name": "jotjson-api",
  "version": "0.1.1",
  "description": "JotJSON API - Azure Functions (Node.js v4, TypeScript). Deployed as SWA managed functions.",
  "private": true,
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "jest",
    "test:integration": "jest --config jest.config.integration.js",
    "cleanup:cosmos-ci": "node scripts/cleanup-orphan-cosmos-containers.mjs",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.3",
    "@azure/functions": "^4.14.0",
    "@azure/identity": "^4.5.0",
    "applicationinsights": "^3.14.0",
    "jsonc-parser": "^3.3.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.3",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3"
  }
}
