{
  "name": "jotjson-api",
  "version": "0.1.0",
  "description": "JotJSON API - Azure Functions (Node.js v4, TypeScript). Deployed as SWA managed functions.",
  "private": true,
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "jest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.1",
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.24.0",
    "jsonc-parser": "^3.3.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3"
  }
}
