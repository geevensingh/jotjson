{
  "name": "jotjson-api",
  "version": "0.1.0",
  "description": "JotJSON API — Azure Functions (Node.js v4, TypeScript). Deployed as SWA managed functions.",
  "private": true,
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "echo \"No API tests yet\" && exit 0",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.1",
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.24.0",
    "jsonc-parser": "^3.3.1",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.7.2"
  }
}
