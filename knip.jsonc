// knip configuration. See https://knip.dev/reference/configuration.
//
// This config enables knip's full unused-detection surface across
// every rule class (deps + exports + types + ns* + files +
// enumMembers + duplicates). No rule is silently disabled.
//
// Run via `npm run lint:unused` (also runs as part of the compound
// `npm run lint`).
//
// Allowlist policy: adding an entry to `ignoreDependencies`,
// `ignoreBinaries`, or the workspace `entry` list requires a
// rationale comment naming the SPECIFIC mechanism by which the dep
// or entry is used (e.g. "compiler-injected via importHelpers:
// true", not the generic "config-referenced"). The specificity is
// the forcing function -- if you can't name a specific mechanism,
// the dep/entry is probably actually unused. Comments may span
// multiple lines; see the existing entries for examples.
{
  "$schema": "https://unpkg.com/knip@6.14.2/schema-jsonc.json",
  "rules": {
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error",
    "files": "error",
  },
  "ignoreBinaries": [
    // Azure Functions Core Tools, installed separately (winget, brew, or
    // the VS Code Azure Functions extension); invoked by api/package.json
    // `"start": "func start"`. Not an npm dep.
    "func",
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/sw.worker.ts",
        "src/environments/environment.example.ts",
        "perf/browser/playwright.perf.config.ts",
        // Perf-browser Playwright specs. knip's playwright plugin does
        // not auto-detect the custom config file name
        // (playwright.perf.config.ts) or its relative
        // `testDir: './scenarios'`, so these spec files are listed
        // explicitly per-file rather than as a glob. The per-file
        // convention preserves orphan-detection: a future WIP scenario
        // dropped into `perf/browser/scenarios/` would NOT be
        // auto-promoted to entry (the playwright bench is human-invoked
        // via `npm run perf:l3`, not exercised by any CI workflow, so a
        // glob would silently mask abandoned WIP specs). Util files
        // under `perf/browser/util/*.ts` reach transitively via imports
        // from these specs and stay detectable. Remove these per-file
        // entries when knip's playwright plugin gains custom-config-name
        // detection (track upstream if appetite arises; otherwise
        // adding a new scenario here is a deliberate per-file act).
        "perf/browser/scenarios/expand-all.spec.ts",
        "perf/browser/scenarios/harness-attach.spec.ts",
        "perf/browser/scenarios/paste-large.spec.ts",
        "perf/browser/scenarios/scroll-after-expand.spec.ts",
        "perf/bench/**/*.bench.ts",
        "perf/fixtures/**/*.ts",
        "src/**/*.perf.ts",
        "e2e/**/*.ts",
        "scripts/**/*.mjs",
      ],
      "project": ["src/**/*.ts", "perf/**/*.ts", "e2e/**/*.ts", "scripts/**/*.mjs"],
      "ignore": ["dist/**", "dist-perf/**", ".angular/**"],
      "ignoreDependencies": [
        // Imported by scripts/generate-icons.mjs at line 25-26, but
        // deliberately NOT in package.json -- the script docstring (lines
        // 5-6) invokes it via `npx --yes --package=sharp@0.33.5
        // --package=png-to-ico@2.1.8 -- node scripts/generate-icons.mjs`
        // so the heavy native modules are only installed when manually
        // regenerating icons, not on every npm install.
        "png-to-ico",
        "sharp",
      ],
    },
    "api": {
      "entry": [
        "src/functions/**/*.ts",
        "src/**/*.test.ts",
        "integration/**/*.ts",
        "scripts/**/*.mjs",
      ],
      "project": ["src/**/*.ts", "integration/**/*.ts", "scripts/**/*.mjs"],
      "ignore": ["dist/**"],
      "ignoreDependencies": [],
    },
  },
}
